{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend --no-audit --no-fund && npm run build --prefix frontend",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/dist/**",
      "excludeFiles": "{.pytest_cache/**,data/**,tests/**,frontend/node_modules/**,frontend/src/**,frontend/*.tsbuildinfo}"
    }
  }
}
